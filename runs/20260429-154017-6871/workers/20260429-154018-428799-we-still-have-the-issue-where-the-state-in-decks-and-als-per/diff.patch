+type CardActivityLike = Pick<
+  CardActivity,
+  "id" | "parentCardId" | "tagIds" | "createdAt" | "studyMs" | "cramMs"
+>;
+
+function mergeCardActivitySources(
+  sources: readonly (readonly CardActivityLike[])[],
+  options?: {
+    hiddenById?: Readonly<Record<string, true>>;
+    reviewStates?: Readonly<CardReviewStateSnapshot>;
+  },
+): CardActivity[] {
+  const merged: CardActivity[] = [];
+  const seenCardIds = new Set<string>();
+
+  for (const source of sources) {
+    for (const card of source) {
+      const id = card.id.trim();
+      if (!id || seenCardIds.has(id)) continue;
+      if (options?.hiddenById?.[id]) continue;
+      if (options?.reviewStates && !options.reviewStates[id]) continue;
+
+      seenCardIds.add(id);
+      merged.push({
+        id,
+        parentCardId: card.parentCardId,
+        tagIds: [...card.tagIds],
+        ...(normalizeStudyTimeMs(card.studyMs) > 0 ? { studyMs: normalizeStudyTimeMs(card.studyMs) } : {}),
+        ...(normalizeStudyTimeMs(card.cramMs) > 0 ? { cramMs: normalizeStudyTimeMs(card.cramMs) } : {}),
+        createdAt: card.createdAt,
+      });
+    }
+  }
+
+  return merged;
+}
+
 function matchesDeckSelection(cardDeckIds: readonly string[], selectedDeckIds: readonly string[]) {
   return selectedDeckIds.length === 0 || cardDeckIds.some((deckId) => selectedDeckIds.includes(deckId));

+export function requeueDelayedStudyRepeats(session: StudySession): StudySession {
+  if (session.delayedRepeats.length === 0) return session
+
+  const nextQueue = [...session.queue, ...session.delayedRepeats.map((repeat) => repeat.card)]
+  return {
+    ...session,
+    queue: nextQueue,
+    delayedRepeats: [],
+    flipped: session.index < nextQueue.length ? session.flipped : false,
+  }
+}

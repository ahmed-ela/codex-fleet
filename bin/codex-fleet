#!/bin/sh
set -eu

script="$0"
if [ -L "$script" ]; then
  target=$(readlink "$script")
  case "$target" in
    /*) script="$target" ;;
    *) script="$(dirname "$script")/$target" ;;
  esac
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

backend="${CODEX_FLEET_BACKEND:-$repo_root/bin/codex-fleet-backend}"
repo_tui="$repo_root/tools/codex-fleet-tui/target/release/codex-fleet-tui"
tui="${CODEX_FLEET_TUI:-$repo_tui}"

ensure_tui() {
  if [ -x "$tui" ]; then
    return 0
  fi
  if command -v cargo >/dev/null 2>&1; then
    (cd "$repo_root/tools/codex-fleet-tui" && cargo build --release >/dev/null)
  fi
  [ -x "$tui" ]
}

if [ "$#" -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ] && ensure_tui; then
    if command -v tmux >/dev/null 2>&1; then
      if [ -n "${TMUX:-}" ]; then
        CODEX_FLEET_BACKEND="$backend" CODEX_FLEET_TMUX_WORKSPACE=1 exec "$tui"
      fi
      session="codex-fleet-$(date +%Y%m%d-%H%M%S)-$$"
      exec tmux new-session \
        -s "$session" \
        -c "$PWD" \
        "CODEX_FLEET_BACKEND='$backend' CODEX_FLEET_TMUX_WORKSPACE=1 exec '$tui'"
    fi
    CODEX_FLEET_BACKEND="$backend" exec "$tui"
  fi
  if [ -t 0 ] && [ -t 1 ] && command -v tmux >/dev/null 2>&1; then
    exec "$backend" headful
  fi
  exec "$backend" quick
fi

case "$1" in
  headful)
    shift
    exec "$backend" headful "$@"
    ;;
  tui)
    shift
    CODEX_FLEET_BACKEND="$backend" exec "$tui" "$@"
    ;;
  *)
    exec "$backend" "$@"
    ;;
esac

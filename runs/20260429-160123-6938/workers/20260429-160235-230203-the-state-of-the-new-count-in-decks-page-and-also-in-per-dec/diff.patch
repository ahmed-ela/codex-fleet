+function mergeCardActivityById(...sources: readonly CardActivity[][]) {
+  const byId = new Map<string, CardActivity>();
+
+  for (const source of sources) {
+    for (const card of source) {
+      const previous = byId.get(card.id);
+      if (!previous) {
+        byId.set(card.id, {
+          ...card,
+          tagIds: dedupeDeckIds(card.tagIds),
+        });
+        continue;
+      }
+
+      byId.set(card.id, {
+        ...previous,
+        parentCardId: previous.parentCardId ?? card.parentCardId,
+        tagIds: dedupeDeckIds([...previous.tagIds, ...card.tagIds]),
+        studyMs: Math.max(
+          normalizeStudyTimeMs(previous.studyMs),
+          normalizeStudyTimeMs(card.studyMs),
+        ),
+        cramMs: Math.max(
+          normalizeStudyTimeMs(previous.cramMs),
+          normalizeStudyTimeMs(card.cramMs),
+        ),
+      });
+    }
+  }
+
+  return Array.from(byId.values());
+}
+
+function sameCardActivity(left: CardActivity, right: CardActivity) {
+  return (
+    left.id === right.id &&
+    left.parentCardId === right.parentCardId &&
+    left.createdAt === right.createdAt &&
+    normalizeStudyTimeMs(left.studyMs) === normalizeStudyTimeMs(right.studyMs) &&
+    normalizeStudyTimeMs(left.cramMs) === normalizeStudyTimeMs(right.cramMs) &&
+    left.tagIds.length === right.tagIds.length &&
+    left.tagIds.every((tagId, index) => tagId === right.tagIds[index])
+  );
+}
+
+function sameCardActivityList(left: readonly CardActivity[], right: readonly CardActivity[]) {
+  return left.length === right.length && left.every((card, index) => sameCardActivity(card, right[index]!));
+}
+
 function matchesDeckSelection(cardDeckIds: readonly string[], selectedDeckIds: readonly string[]) {
   return selectedDeckIds.length === 0 || cardDeckIds.some((deckId) => selectedDeckIds.includes(deckId));
 }

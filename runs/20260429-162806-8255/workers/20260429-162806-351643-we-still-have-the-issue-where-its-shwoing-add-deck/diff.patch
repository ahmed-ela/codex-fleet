+function countSavedStudySessionRemaining(
+  saved: SavedStudySession | null | undefined,
+  mode: StudyMode,
+  reviewStates: CardReviewStateSnapshot,
+): DeckReviewCounts | null {
+  if (!saved) return null;
+
+  const queueIds = saved.queueIds
+    .map((cardId) => String(cardId ?? "").trim())
+    .filter(Boolean);
+  const delayedRepeatIds = (saved.delayedRepeats ?? [])
+    .map((repeat) => String(repeat?.cardId ?? "").trim())
+    .filter(Boolean);
+  const index = Math.min(
+    queueIds.length,
+    Math.max(0, Math.floor(Number(saved.index) || 0)),
+  );
+
+  if (index >= queueIds.length && delayedRepeatIds.length === 0) return null;
+
+  const seenCardIds = new Set(queueIds.slice(0, index));
+  const countedCardIds = new Set<string>();
+  let newCount = 0;
+  let learnCount = 0;
+  let dueCount = 0;
+
+  for (const cardId of queueIds.slice(index)) {
+    if (countedCardIds.has(cardId)) continue;
+    countedCardIds.add(cardId);
+
+    const state = mode === "review" ? reviewStates[cardId] : null;
+    if (seenCardIds.has(cardId) || state?.bucket === "learn") {
+      learnCount += 1;
+    } else if (state?.bucket === "due") {
+      dueCount += 1;
+    } else {
+      newCount += 1;
+    }
+  }
+
+  for (const cardId of delayedRepeatIds) {
+    if (countedCardIds.has(cardId)) continue;
+    countedCardIds.add(cardId);
+    learnCount += 1;
+  }
+
+  return { newCount, learnCount, dueCount };
+}
